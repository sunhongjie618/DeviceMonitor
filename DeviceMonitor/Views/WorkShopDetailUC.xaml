<UserControl x:Class="DeviceMonitor.Views.WorkShopDetailUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DeviceMonitor.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 机台状态筛选按钮 -->
        <Style x:Key="FilterRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="#8FAFC4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#0E2438" BorderBrush="#2A4E6A"
                                BorderThickness="1" CornerRadius="3" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2FD6E8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2FD6E8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2FD6E8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态圆点：颜色随机台状态变化 -->
        <Style x:Key="StatusDot" TargetType="Border">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#4ADE80"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="等待">
                    <Setter Property="Background" Value="#F5A623"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="故障">
                    <Setter Property="Background" Value="#FF6B6B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="停机">
                    <Setter Property="Background" Value="#8FAFC4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4ADE80"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="等待">
                    <Setter Property="Foreground" Value="#F5A623"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="故障">
                    <Setter Property="Foreground" Value="#FF6B6B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="停机">
                    <Setter Property="Foreground" Value="#8FAFC4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- 第一行：返回 + 车间名 + 状态筛选 -->
        <Border Background="#1118aabd" CornerRadius="4">
            <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding DataContext.GoBackMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="返回" Style="{StaticResource BtnStyle}" Tag="&#xe632;"
                            Height="28" Width="80"/>
                    <TextBlock Text="{Binding WorkShopName}" Foreground="White" FontSize="16"
                               Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="机台状态" Foreground="#99ffffff" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <RadioButton Content="全部" Style="{StaticResource FilterRadio}" IsChecked="True"
                                 Command="{Binding ChangeFilterCommand}" CommandParameter="全部"/>
                    <RadioButton Content="作业中" Style="{StaticResource FilterRadio}"
                                 Command="{Binding ChangeFilterCommand}" CommandParameter="作业中"/>
                    <RadioButton Content="等待" Style="{StaticResource FilterRadio}"
                                 Command="{Binding ChangeFilterCommand}" CommandParameter="等待"/>
                    <RadioButton Content="故障" Style="{StaticResource FilterRadio}"
                                 Command="{Binding ChangeFilterCommand}" CommandParameter="故障"/>
                    <RadioButton Content="停机" Style="{StaticResource FilterRadio}"
                                 Command="{Binding ChangeFilterCommand}" CommandParameter="停机"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 第二行：本车间统计 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,10,10,0">
            <TextBlock Foreground="#99ffffff" FontSize="11" VerticalAlignment="Center">
                <Run Text="机台总数 "/><Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="White" FontSize="13"/>
            </TextBlock>
            <TextBlock Foreground="#4ADE80" FontSize="11" Margin="24,0,0,0" VerticalAlignment="Center">
                <Run Text="作业 "/><Run Text="{Binding WorkingCount, Mode=OneWay}" FontSize="13"/>
            </TextBlock>
            <TextBlock Foreground="#F5A623" FontSize="11" Margin="20,0,0,0" VerticalAlignment="Center">
                <Run Text="等待 "/><Run Text="{Binding WaitCount, Mode=OneWay}" FontSize="13"/>
            </TextBlock>
            <TextBlock Foreground="#FF6B6B" FontSize="11" Margin="20,0,0,0" VerticalAlignment="Center">
                <Run Text="故障 "/><Run Text="{Binding WrongCount, Mode=OneWay}" FontSize="13"/>
            </TextBlock>
            <TextBlock Foreground="#8FAFC4" FontSize="11" Margin="20,0,0,0" VerticalAlignment="Center">
                <Run Text="停机 "/><Run Text="{Binding StopCount, Mode=OneWay}" FontSize="13"/>
            </TextBlock>
        </StackPanel>

        <!-- 第三行：机台卡片 -->
        <ScrollViewer Grid.Row="2" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MachineList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8,5" BorderBrush="#9918aabd" Background="#0a18aabd"
                                BorderThickness="0,1,0,0" MinHeight="232">
                            <Grid TextBlock.FontSize="11" Margin="0,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>

                                <!-- 机台名 + 状态 -->
                                <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="12" Foreground="#aaffffff">
                                    <Run Text="&#xe661;" FontFamily="../Resource/Fonts/#iconfont"/>
                                    <Run Text="{Binding MachineName}"/>
                                </TextBlock>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Border Style="{StaticResource StatusDot}"/>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                                </StackPanel>

                                <!-- 环形进度 -->
                                <local:RingUC Grid.Row="1" PercentValue="{Binding Percent}" Margin="24"/>

                                <!-- 任务状态 -->
                                <StackPanel Margin="14,0" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="任务状态:" Foreground="#55ffffff"/>
                                    <TextBlock Text="{Binding Status}" Foreground="White" Margin="6,0,0,0"/>
                                </StackPanel>

                                <!-- 任务进度 -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                    <TextBlock Text="任务进度:" Foreground="#55ffffff"/>
                                    <TextBlock Foreground="White" Margin="6,0,0,0">
                                        <Run Text="{Binding FinishedCount}"/><Run Text=" / "/><Run Text="{Binding PlanCount}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 工单 -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                    <TextBlock Text="工单:" Foreground="#55ffffff"/>
                                    <TextBlock Foreground="White" Text="{Binding OrderNo}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
