<Window x:Class="DeviceMonitor.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - 生产监控平台"
        Height="470" Width="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B1A2A"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7F9FB5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#E6F4FF"/>
            <Setter Property="Background" Value="#0A1A2A"/>
            <Setter Property="BorderBrush" Value="#1E4A6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#2FD6E8"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="#06131F"/>
            <Setter Property="Background" Value="#2FD6E8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5EE3F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1E4A6B" BorderThickness="1" Background="#0B1A2A">
        <Grid Margin="34,26,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◆" Foreground="#2FD6E8" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CaptionText}" Foreground="#E6F4FF" FontSize="13"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Width="26" Height="26" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Foreground="#7F9FB5"
                        FontSize="13" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="账号登录" Foreground="White" FontSize="24" Margin="0,28,0,4"/>
            <TextBlock Grid.Row="2" Text="采集数据与账号信息保存在本机 SQLite" Foreground="#5F7F95"
                       FontSize="12" Margin="0,0,0,22"/>

            <!-- 用户名 -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UserNameBox" Style="{StaticResource InputBox}"
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- 密码 -->
            <StackPanel Grid.Row="4" Margin="0,16,0,0">
                <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox" Height="38" Foreground="#E6F4FF" Background="#0A1A2A"
                             BorderBrush="#1E4A6B" BorderThickness="1" Padding="10,0"
                             VerticalContentAlignment="Center" FontSize="13"
                             KeyDown="Password_KeyDown"/>
            </StackPanel>

            <!-- 错误提示 -->
            <TextBlock Grid.Row="5" Text="{Binding ErrorText}" Foreground="#FF6B6B" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>

            <!-- 登录按钮 -->
            <Button x:Name="LoginButton" Grid.Row="6" Content="登 录" Style="{StaticResource PrimaryButton}"
                    Margin="0,18,0,0" Click="Login_Click"/>

            <TextBlock Grid.Row="7" Text="{Binding HintText}" Foreground="#4E6B80" FontSize="11"
                       VerticalAlignment="Bottom" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
