<UserControl x:Class="DeviceMonitor.Views.SettingsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0E2438"/>
        <SolidColorBrush x:Key="LineBrush" Color="#1E4E6B"/>
        <SolidColorBrush x:Key="TextBrush" Color="#CFE8F5"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#8FAFC4"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2FD6E8"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8F4FA"/>
            <Setter Property="CaretBrush" Value="#E8F4FA"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{StaticResource PanelBrush}"
                                BorderBrush="#2A4E6A" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#183A52" CornerRadius="4" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F4C6B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="#0B1C2A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="18,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#7FE7F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Padding="22,14" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态文字：正常灰色，出错红色 -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="#FF6B6B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <Border Background="#1118aabd" CornerRadius="4">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="系统设置" Foreground="White" FontSize="16"/>
                    <TextBlock Text="通讯参数 / 采集点位 / 环境阈值" Foreground="#8FAFC4" FontSize="12"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding FilePath, StringFormat=配置文件：{0}}" Foreground="#5F87A0" FontSize="11"
                           Margin="16,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 主体：页签 + 底部操作条 -->
        <Border Grid.Row="1" Margin="0,6,0,0" Background="#0a18aabd"
                BorderBrush="#9918aabd" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                    <!-- 通讯配置 -->
                    <TabItem Header="通讯配置">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,18">
                                <TextBlock Text="PLC 连接参数" Style="{StaticResource SectionTitle}"/>

                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,16,14">
                                        <TextBlock Text="通讯方式" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,14">
                                        <TextBlock Text="串口号" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="波特率" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,16,14">
                                        <TextBlock Text="数据位" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,14">
                                        <TextBlock Text="校验位" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Parity, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="停止位" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding StopBits, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,16,14">
                                        <TextBlock Text="从站地址" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,14">
                                        <TextBlock Text="读取超时 (ms)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding ReadTimeoutMs, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="采集周期 (ms)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,6,0,14"/>

                                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                           Text="说明：读取超时必须小于采集周期（例如 350 &lt; 500），否则一次读失败会把采集节拍拖住。协议里的字序（高低字颠倒）不在本页配置，由解析层按设备手册处理。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 采集点位 -->
                    <TabItem Header="采集点位">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,18">
                                <TextBlock Text="控制器 1# · Modbus RTU · 从站 1" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="76"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="点位名称" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="寄存器地址" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="数据类型" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="单位" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Points}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="76"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Height="28" Margin="0,0,10,0"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Column="1" Height="28" Margin="0,0,10,0"
                                                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Column="2" Height="28" Margin="0,0,10,0"
                                                             Text="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Column="3" Height="28" Margin="0,0,10,0"
                                                             Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <Button Grid.Column="4" Content="删除" Style="{StaticResource GhostButton}"
                                                            Padding="10,3" Foreground="#FF8A8A"
                                                            Command="{Binding DataContext.DeletePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ 新增点位" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                        Margin="0,14,0,0" Command="{Binding AddPointCommand}"/>

                                <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"
                                           Text="地址填 40001 这种展示地址，解析层再换算成 0 基偏移（和手册一一对应，抄表不容易错）。数据类型支持 UInt16 / Int16 / UInt32 / Int32 / Float32。同一设备的点位会按地址块合并读取，128 个点位大约 8 次请求，而不是 128 次。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 环境阈值 -->
                    <TabItem Header="环境阈值">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,18">
                                <TextBlock Text="采集阈值（超出范围触发报警）" Style="{StaticResource SectionTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="监测项" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="下限" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="上限" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="单位" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Height="1" Background="{StaticResource LineBrush}" VerticalAlignment="Top"/>

                                    <TextBlock Grid.Row="2" Text="温度" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,14,0"
                                             Text="{Binding TemperatureLow, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Row="2" Grid.Column="2" Margin="0,0,14,0"
                                             Text="{Binding TemperatureHigh, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="℃" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Text="湿度" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,14,0"
                                             Text="{Binding HumidityLow, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Row="3" Grid.Column="2" Margin="0,0,14,0"
                                             Text="{Binding HumidityHigh, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="%" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="4" Text="PM2.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,14,0"
                                             Text="{Binding Pm25Low, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Row="4" Grid.Column="2" Margin="0,0,14,0"
                                             Text="{Binding Pm25High, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="µg/m³" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="5" Text="硫化氢" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,14,0"
                                             Text="{Binding H2sLow, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Row="5" Grid.Column="2" Margin="0,0,14,0"
                                             Text="{Binding H2sHigh, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="3" Text="PPM" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"
                                           Text="下限必须小于上限。阈值保存后由报警引擎使用：同一项在阈值内持续越限超过设定时长才生成一条报警，避免抖动刷屏。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- 底部操作条 -->
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,1,0,0" Padding="24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusText}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                    Command="{Binding SaveCommand}"/>
                            <Button Content="测试连接" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                    Command="{Binding TestConnectionCommand}"/>
                            <Button Content="恢复默认" Style="{StaticResource GhostButton}"
                                    Command="{Binding ResetDefaultCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
