<UserControl x:Class="DeviceMonitor.Views.ReportUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CFE8F5"/>
            <Setter Property="Background" Value="#1A2FD6E8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#332FD6E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#552FD6E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7F9FB5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2FD6E8"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7F9FB5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFE8F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Background="#1118aabd" CornerRadius="4">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="#8FAFC4" FontSize="12"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="刷新" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshRowsCommand}"/>
                    <Button Content="导出原始数据" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Command="{Binding ExportRawCsvCommand}"/>
                    <Button Content="导出 CSV" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportCsvCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,8,0,0">
            <Border Background="#0D1E33" CornerRadius="4" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="今日产量合计（按小时累计差）" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding TotalProduceText}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Background="#0D1E33" CornerRadius="4" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="不良合计（按小时累计差）" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding TotalBadText}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Background="#0D1E33" CornerRadius="4" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="良品率" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding PassRateText}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Background="#0D1E33" CornerRadius="4" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="产量峰值时段" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding PeakText}" Foreground="#2FD6E8" FontSize="14" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 明细表 -->
        <Border Grid.Row="2" Margin="0,8,0,0" Background="#0a18aabd" CornerRadius="4"
                BorderBrush="#9918aabd" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Border Background="#0D1E33">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="时段" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="1" Text="生产数" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="2" Text="不良数" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="3" Text="良品率" Style="{StaticResource Head}"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="34" BorderBrush="#1418aabd" BorderThickness="0,0,0,1">
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Hour}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProduceText}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BadText}" Style="{StaticResource Cell}"
                                                   Foreground="#FF9F5A"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PassRateText}" Style="{StaticResource Cell}"
                                                   Foreground="#4ADE80"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部说明 -->
        <StackPanel Grid.Row="3" Margin="0,8,0,2">
            <TextBlock Text="{Binding SourceText}" Foreground="#7F9FB5" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DbInfoText}" Foreground="#4ADE80" FontSize="11" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding RealProduceText}" Foreground="#8FAFC4" FontSize="11" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding ExportText}" Foreground="#2FD6E8" FontSize="11" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
