<Window x:Class="DeviceMonitor.Views.MainWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:DeviceMonitor.Views"
        mc:Ignorable="d"
        Title="生产监控平台" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"></WindowChrome>
    </WindowChrome.WindowChrome>

    <Grid>
        <!--背景颜色渐变(径向渐变)-->
        <Grid.Background>
            <RadialGradientBrush>
                <!--GradientStop 从里向外-->
                <GradientStop Color="#FF285173" Offset="0"></GradientStop>
                <GradientStop Color="#FF244967" Offset="0.5"></GradientStop>
                <GradientStop Color="#FF14273A" Offset="1"></GradientStop>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
        </Grid.RowDefinitions>

        <!--第一行 头部-->
        <Border BorderThickness="0,0,0,1" BorderBrush="#5518aabd">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Margin="10,7" Source="/Resource/Images/Boss.jpg" />
                    <ToggleButton x:Name="MenuToggleButton" Foreground="LightBlue" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Width="40" Height="40"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  AutomationProperties.Name="HamburgerToggleButton" IsChecked="False"
Style="{StaticResource MaterialDesignHamburgerToggleButton}" />
                </StackPanel>

                <StackPanel Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="生产监控平台" Foreground="White" FontSize="20"></TextBlock>
                    <TextBlock Text="苦海无涯,学无止境!" Foreground="White" FontSize="15" Margin="0,2,0,0"></TextBlock>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="16"></RowDefinition>
                    </Grid.RowDefinitions>

                    <StackPanel WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Right" Background="Transparent" Grid.Column="2" Grid.Row="0" Orientation="Horizontal">
                        <Button Content="&#xe624;" Style="{StaticResource OperateBtnStyle}" Click="Button_Click"></Button>
                        <Button Content="&#xe600;" Style="{StaticResource OperateBtnStyle}" Click="Button_Click_1"></Button>
                        <Button Content="&#xe609;" Style="{StaticResource OperateBtnStyle}"  Click="Button_Click_2">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetProperty="Background.Color" To="DarkRed" Duration="0:0:0:0.2"></ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="0:0:0:0.2"></ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                            </Button.Triggers>
                        </Button>
                    </StackPanel>
                    <!--第二行-->
                    <Border Grid.Row="1"  BorderThickness="0,1,0,0" BorderBrush="#5518aabd">
                        <Border.Background>
                            <VisualBrush TileMode="FlipXY" Viewport="0,0,7,7" ViewportUnits="Absolute">
                                <VisualBrush.Visual>
                                    <Line X1="0" Y1="10" X2="10" Y2="0" Stroke="Gray" StrokeThickness="1"></Line>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                    </Border>




                </Grid>


            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- 主内容 -->
            <ContentControl x:Name="MainContent" Content="{Binding CurrentPage}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

            <!-- 遮罩：点一下关抽屉，随按钮选中状态显示 -->
            <Border x:Name="DrawerMask" Background="#88000000"
            MouseLeftButtonUp="DrawerMask_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=MenuToggleButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- 抽屉：宽度从 0 动画到 200 -->
            <Border x:Name="DrawerPanel" Width="0" HorizontalAlignment="Left"
            ClipToBounds="True" Background="#0E2438"
            BorderBrush="#1E4E6B" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=MenuToggleButton}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="180"
                                                     Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="0"
                                                     Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ListBox x:Name="MenuListBox" Width="180" ItemsSource="{Binding LeftMenuList}"
                 SelectedItem="{Binding SelectedMenu, Mode=TwoWay}"
                 SelectionChanged="MenuListBox_SelectionChanged"
                 ItemContainerStyle="{StaticResource LeftMenuStyle}"
                 Foreground="#CFE8F5" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center" Height="38" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="{Binding Icon}" Width="18" Height="18"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"></materialDesign:PackIcon>
                                <TextBlock Grid.Column="1" Text="{Binding MenuName}" FontSize="14"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"></TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>


    </Grid>
</Window>
