<UserControl x:Class="DeviceMonitor.Views.AlarmUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CFE8F5"/>
            <Setter Property="Background" Value="#1A2FD6E8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#332FD6E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#552FD6E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AckButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="FilterRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8FAFC4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#0D1E33" CornerRadius="4" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2FD6E8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2FD6E8"/>
                                <Setter Property="Foreground" Value="#06131F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7F9FB5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="ChipValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2FD6E8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7F9FB5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFE8F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Background="#1118aabd" CornerRadius="4">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="#8FAFC4" FontSize="12"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="全部确认" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding AckAllCommand}"/>
            </Grid>
        </Border>

        <!-- 统计 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <Border Background="#0D1E33" CornerRadius="4" Padding="14,7" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="报警总数" Style="{StaticResource ChipLabel}"/>
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource ChipValue}"/>
                </StackPanel>
            </Border>
            <Border Background="#0D1E33" CornerRadius="4" Padding="14,7" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="未确认" Style="{StaticResource ChipLabel}"/>
                    <TextBlock Text="{Binding UnackedText}" Style="{StaticResource ChipValue}"/>
                </StackPanel>
            </Border>
            <Border Background="#0D1E33" CornerRadius="4" Padding="14,7" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="进行中" Style="{StaticResource ChipLabel}"/>
                    <TextBlock Text="{Binding ActiveText}" Style="{StaticResource ChipValue}"/>
                </StackPanel>
            </Border>
            <Border Background="#0D1E33" CornerRadius="4" Padding="14,7">
                <StackPanel>
                    <TextBlock Text="当前阈值" Style="{StaticResource ChipLabel}"/>
                    <TextBlock Text="{Binding ThresholdText}" Style="{StaticResource ChipValue}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 筛选 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <TextBlock Text="筛选" Foreground="#7F9FB5" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton Content="全部" Style="{StaticResource FilterRadio}" GroupName="AlarmFilter" IsChecked="True"
                         Command="{Binding SetFilterCommand}" CommandParameter="全部"/>
            <RadioButton Content="进行中" Style="{StaticResource FilterRadio}" GroupName="AlarmFilter"
                         Command="{Binding SetFilterCommand}" CommandParameter="进行中"/>
            <RadioButton Content="未确认" Style="{StaticResource FilterRadio}" GroupName="AlarmFilter"
                         Command="{Binding SetFilterCommand}" CommandParameter="未确认"/>
            <RadioButton Content="已确认" Style="{StaticResource FilterRadio}" GroupName="AlarmFilter"
                         Command="{Binding SetFilterCommand}" CommandParameter="已确认"/>
        </StackPanel>

        <!-- 列表 -->
        <Border Grid.Row="3" Background="#0a18aabd" CornerRadius="4"
                BorderBrush="#9918aabd" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Border Background="#0D1E33">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="时间" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="1" Text="等级" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="2" Text="来源" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="3" Text="描述" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="4" Text="持续" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="5" Text="状态" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="6" Text="操作" Style="{StaticResource Head}"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Alarms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="38" BorderBrush="#1418aabd" BorderThickness="0,0,0,1">
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Cell}"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Level}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                                    <Setter Property="Foreground" Value="#4ADE80"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="高">
                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="中">
                                                            <Setter Property="Foreground" Value="#F5A623"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource Cell}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding DurationText}" Style="{StaticResource Cell}"/>

                                        <TextBlock Grid.Column="5" Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                                    <Setter Property="Foreground" Value="#8FAFC4"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EndedAt}" Value="{x:Null}">
                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Grid Grid.Column="6">
                                            <Button Content="确认"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.AckCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AckButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAcked}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Text="✓ 已确认" Foreground="#4ADE80" FontSize="11"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAcked}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
