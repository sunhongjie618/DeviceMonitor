<Application x:Class="DeviceMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeviceMonitor"
             xmlns:vm="clr-namespace:DeviceMonitor.ViewModels"
             xmlns:views="clr-namespace:DeviceMonitor.Views"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/StylesDic/OperateBtnStyleDic.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/StylesDic/BtnStyleDic.xaml"></ResourceDictionary>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LeftMenuStyle" TargetType="ListBoxItem">
                <Setter Property="MinHeight" Value="38"></Setter>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                <Setter Property="Cursor" Value="Hand"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <Border x:Name="border"></Border>
                                <Border x:Name="accent" Width="3" HorizontalAlignment="Left"
                                        Background="#2FD6E8" Opacity="0"></Border>
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"></ContentPresenter>
                            </Grid>

                            <!--触发器-->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource NavItemHoverBrush}"></Setter>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource NavItemActiveBrush}"></Setter>
                                    <Setter TargetName="accent" Property="Opacity" Value="1"></Setter>
                                    <Setter Property="Foreground" Value="White"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <SolidColorBrush x:Key="NavItemHoverBrush"  Color="#0D2FD6E8"/>
            <!-- 5% 的强调色 -->
            <SolidColorBrush x:Key="NavItemActiveBrush" Color="#1A2FD6E8"/>
            <!-- 10% 的强调色 -->

            <!-- 页面 VM → 视图 的隐式映射：ContentControl 拿到 VM 后自动套用对应 View -->
            <DataTemplate DataType="{x:Type vm:MonitorUCViewModel}">
                <views:MonitorUC/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:WorkshopListUCViewModel}">
                <views:WorkshopListUC/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:WorkShopDetailUCViewModel}">
                <views:WorkShopDetailUC/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsUC/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DeviceUCViewModel}">
                <views:DeviceUC/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AlarmUCViewModel}">
                <views:AlarmUC/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReportUCViewModel}">
                <views:ReportUC/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
